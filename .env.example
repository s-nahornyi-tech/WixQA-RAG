# The settings of the commands. They are read from the environment and from
# nowhere else: set them in the shell or in the CI job. Never commit a value.

# Connection string of the vector store (PostgreSQL with pgvector).
# Read by `index build` and `index audit`.
DATABASE_URL=

# Key of the embedding provider.
# Read by `index build`, and only when passages have to be embedded.
OPENAI_API_KEY=
